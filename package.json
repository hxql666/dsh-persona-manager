{
  "name": "@hxql/dsh-persona-manager",
  "version": "0.1.2",
  "description": "Persona manager for DeepSeek Harness: create, edit, and freely switch multiple system personas, with a global default and per-session overrides. · DSH 人设管理插件：添加并保存人设词，自由切换多人设，支持全局默认与会话级覆盖。",
  "type": "module",
  "license": "MIT",
  "author": "hxql",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/DESIGN.md",
    "docs/PUBLISH.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "cordis",
    "persona",
    "system-prompt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxql666/dsh-persona-manager.git"
  },
  "homepage": "https://github.com/hxql666/dsh-persona-manager#readme",
  "bugs": {
    "url": "https://github.com/hxql666/dsh-persona-manager/issues"
  },
  "scripts": {
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  }
}
